# Cấu hình kết nối cơ sở dữ liệu (Database Configuration)
# Sao chép file này thành .env và điền thông tin thực tế của bạn
# Chú ý: File .env đã được cấu hình trong .gitignore để không bao giờ bị đẩy lên GitHub

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ProductManagerDB;encrypt=false;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=your_database_password_here
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
