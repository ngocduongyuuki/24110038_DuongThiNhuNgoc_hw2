# Cấu hình kết nối cơ sở dữ liệu (Database Configuration)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ProductManagerDB;encrypt=false;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=your_database_password_here
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Cấu hình gửi email OTP qua Gmail SMTP (Email Configuration)
# Để gửi email qua Gmail:
# 1. Bật Xác minh 2 bước (2-Step Verification) trong tài khoản Google
# 2. Truy cập: https://myaccount.google.com/apppasswords
# 3. Tạo Mật khẩu ứng dụng (App Password) gồm 16 ký tự (ví dụ: abcd efgh ijkl mnop)
# 4. Điền địa chỉ Gmail vào MAIL_USERNAME và mật khẩu ứng dụng vào MAIL_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM=your_gmail_address@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
